<Context path="/jasperserver" reloadable="false">
            
    <!-- ANGGARAN KONEKSI (BUGFIX: pool melebihi kapasitas server database)
         Keempat pool di bawah semula maxActive="100", jadi total 400 koneksi,
         sementara PostgreSQL default hanya mengizinkan max_connections=100.
         Di bawah beban, pool ke-2 yang penuh akan gagal dengan
         "FATAL: sorry, too many clients already" alih-alih menunggu.

         Alokasi sekarang berjumlah 80, menyisakan 20 untuk superuser,
         pekerjaan pemeliharaan, dan psql:
             repository  40   (jalur panas: resource, ACL, scheduler)
             audit       10   (tulis bervolume rendah)
             sugarcrm    15   (datasource contoh)
             foodmart    15   (datasource contoh + kubus Mondrian)
         Kalau max_connections dinaikkan, naikkan angka-angka ini bersamaan.

         maxWait: lama menunggu koneksi tersedia (ms) sebelum melempar
         exception. -1 berarti menunggu selamanya.

         Evictor (timeBetweenEvictionRunsMillis) dinyalakan supaya koneksi
         menganggur benar-benar ditutup. Tanpa itu DBCP hanya membuang
         kelebihan idle saat koneksi dikembalikan, sehingga pool yang sempat
         membesar akan menahan koneksi itu tanpa batas waktu.
    -->

    <Resource name="${js.jndi}" auth="Container" type="javax.sql.DataSource"
        maxActive="40" maxIdle="10" maxWait="10000"
        timeBetweenEvictionRunsMillis="30000" minEvictableIdleTimeMillis="60000"
        testWhileIdle="true"
        username="${js.dbUsername}" password="${escapeXML:js.dbPassword}"
        driverClassName="${jdbcDriverClass}"
        accessToUnderlyingConnectionAllowed = "true"
        validationQuery="${jdbcTestTableQuery}"
        testOnBorrow="true"
        url="${js.jdbcUrl}"
        factory="${tomcatBasicDatasourceFactory}"
        ${js.extraParams} />

	<Resource name="${audit.jndi}" auth="Container" type="javax.sql.DataSource"
        maxActive="10" maxIdle="5" maxWait="10000"
        timeBetweenEvictionRunsMillis="30000" minEvictableIdleTimeMillis="60000"
        testWhileIdle="true"
        username="${audit.dbUsername}" password="${escapeXML:audit.dbPassword}"
        driverClassName="${jdbcDriverClass}"
        accessToUnderlyingConnectionAllowed = "true"
        validationQuery="${jdbcTestTableQuery}"
        testOnBorrow="true"
        url="${audit.jdbcUrl}"
        factory="${tomcatBasicDatasourceFactory}"
        ${js.extraParams} />

    <Resource name="${sugarcrm.jndi}" auth="Container" type="javax.sql.DataSource"
        maxActive="15" maxIdle="5" maxWait="10000"
        timeBetweenEvictionRunsMillis="30000" minEvictableIdleTimeMillis="60000"
        testWhileIdle="true"
        username="${sugarcrm.dbUsername}" password="${escapeXML:sugarcrm.dbPassword}"
        driverClassName="${jdbcDriverClass}"
        accessToUnderlyingConnectionAllowed = "true"
        validationQuery="${jdbcTestTableQuery}"
        testOnBorrow="true"
        url="${sugarcrm.jdbcUrl}"
        factory="${tomcatBasicDatasourceFactory}"/>

    <Resource name="${foodmart.jndi}" auth="Container" type="javax.sql.DataSource"
        maxActive="15" maxIdle="5" maxWait="10000"
        timeBetweenEvictionRunsMillis="30000" minEvictableIdleTimeMillis="60000"
        testWhileIdle="true"
        username="${foodmart.dbUsername}" password="${escapeXML:foodmart.dbPassword}"
        driverClassName="${jdbcDriverClass}"
        accessToUnderlyingConnectionAllowed = "true"
        validationQuery="${jdbcTestTableQuery}"
        testOnBorrow="true"
        url="${foodmart.jdbcUrl}"
        factory="${tomcatBasicDatasourceFactory}"/>

    <!-- Comment this line to enable session persistence across Tomcat restarts -->
    <Manager pathname="" />
</Context>
